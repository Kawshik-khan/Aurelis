# ==============================================================================
# AURELIS PRIVATE WEALTH PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND DEPLOYMENT (RENDER / VPS / DOCKER)
# ------------------------------------------------------------------------------
# Neon Cloud PostgreSQL Connection String (Required for Production Database)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxxxxxx@ep-soft-voice-a5xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for client authentication tokens
JWT_SECRET=aurelis_sovereign_private_wealth_jwt_secret_key_2026_super_secure

# Backend Port (Render automatically supplies PORT=10000)
PORT=4000

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. FRONTEND DEPLOYMENT (VERCEL)
# ------------------------------------------------------------------------------
# In Vercel Project Settings -> Environment Variables:
# Set this to your live Render backend URL ending in /v1
VITE_API_URL=https://your-aurelis-backend.onrender.com/v1

# Set this to your live Render WebSocket stream URL ending in /ws
VITE_WS_URL=wss://your-aurelis-backend.onrender.com/ws
